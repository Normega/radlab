{
  "functions": {
    "api/ingest.js": { "maxDuration": 300 },
    "api/cite.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/spellbook", "destination": "/spellbook/", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "utmap.org" }], "destination": "https://radlab.zone/utmaps", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.utmap.org" }], "destination": "https://radlab.zone/utmaps", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "utmap.org" }], "destination": "https://radlab.zone/utmaps", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.utmap.org" }], "destination": "https://radlab.zone/utmaps", "permanent": true }
  ],
  "rewrites": [
    { "source": "/spellbook/", "destination": "/spellbook/index.html" },
    { "source": "/((?!api/)(?!.*\\.(?:js|mjs|css|map|json|html|xml|txt|csv|pdf|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2|ttf|otf|eot|mp3|mp4|webm|wav|ogg|zip)$).*)", "destination": "/index.html" }
  ]
}
