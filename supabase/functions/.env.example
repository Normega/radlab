# Set these in Supabase Dashboard → Edge Functions → Secrets before deploying.

# API key from resend.com dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender address in your Resend domain.
# Must be a domain verified in Resend — radlab.vercel.app never could be, and
# was the placeholder here until 2026-07-30.
FROM_EMAIL=research@radlab.zone

# Public URL of the platform (no trailing slash). radlab.zone is canonical:
# www 308s to it, and the RA-generated participant links are built on it.
SITE_URL=https://radlab.zone

# From Supabase → Settings → API → service_role key (secret, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
